# Merge on top of a virtme-ng config (vng --kconfig) for an arm64 kernel.
# For 4K pages drop the two page size lines; only the -o scenario then fails.
CONFIG_ARM64_64K_PAGES=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_BLK_DEV_NULL_BLK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CONFIGFS_FS=y
CONFIG_AIO=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
